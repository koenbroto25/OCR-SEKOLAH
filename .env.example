# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon Storage (S3-compatible) — untuk gambar scan dokumen
# Bucket per jenis dokumen (buat di dashboard Neon: ktp, kartu-keluarga, akte-kelahiran)
AWS_ENDPOINT_URL_S3=https://br-xxxx.storage.c-x.us-east-2.aws.neon.tech
AWS_ACCESS_KEY_ID=your_key_id
AWS_SECRET_ACCESS_KEY=your_secret
AWS_REGION=us-east-2
AWS_S3_BUCKET_KTP=ktp
AWS_S3_BUCKET_KK=kartu-keluarga
AWS_S3_BUCKET_AKTE=akte-kelahiran

# Google APIs (hanya untuk upload gambar ke Drive)
VITE_GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY=path_to_json_key_file_or_raw_private_key

# JWT & Security
VITE_JWT_SECRET=your_jwt_secret_key_min_32_chars_here
VITE_JWT_EXPIRY=7d

# Admin Credentials
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD_HASH=$2a$10$9Xenoglh3mQYxDx2Vbijc.NdHT4AYsvrjRnCoxThk47G5dRSakFZK # (bcrypt hash of '123456')

# App Config
VITE_APP_NAME=OCR Sekolah
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:5173

# Image Compression
VITE_IMAGE_QUALITY=75
VITE_IMAGE_MAX_SIZE=500000
